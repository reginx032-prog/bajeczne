AddDefaultCharset UTF-8
AddCharset UTF-8 .css .js .xml .svg

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:_preview|_publish|tools|data|facebook-posts)(?:/|$) - [R=404,L]

  RewriteCond %{HTTP_HOST} ^www\.bajeczneurwisy\.pl$ [NC]
  RewriteRule ^ https://bajeczneurwisy.pl%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^bajeczneurwisy\.pl$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://bajeczneurwisy.pl%{REQUEST_URI} [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ https://bajeczneurwisy.pl/ [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "-[a-f0-9]{12}-[0-9]+\.webp$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
